PORT=5000
JWT_SECRET=super_secret_jwt_key_here

# Google Classroom OAuth Credentials
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a new project and enable the "Google Classroom API"
# 3. Create OAuth 2.0 Client IDs (Web application)
# 4. Add Authorized redirect URI: http://localhost:5000/api/classroom/callback
# 5. Copy the Client ID and Client Secret below

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/classroom/callback
