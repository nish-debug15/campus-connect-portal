# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/campus_connect

# JWT Authentication Secret
JWT_SECRET=rv_university_campus_connect_secret_jwt_key_2026

# Google Classroom OAuth2 Credentials (Optional - portal includes simulation mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/classroom/callback

# Demo Mode toggle (Set to true to force simulation mode without Google Cloud OAuth)
DEMO_MODE=true
